# Kopiér denne fil til .env.local og udfyld værdierne der. Commit aldrig .env.local.
# Nøgler må kun bruges server-side (server/, proxy.ts, app/api/). Aldrig i klientkode eller logs.

# Supabase (EU-region). NEXT_PUBLIC_* er offentlige, men beskyttes af RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kun server. Må kun bruges til kontosletning, oprydningsjob, seed og admin-scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Adresseopslag af klinikkernes placering (OpenStreetMap Nominatim, ingen nøgle; clinics 4.3). Lad den være tom.
# 1 = falsk opslag uden netværkskald (kun til tests; sættes af tests/api/run.sh og tests/e2e/run.sh, ignoreres i produktion).
GEOCODING_FAKE=

# OpenAI (kun server)
OPENAI_API_KEY=
OPENAI_MODEL=

# Sidens adresse til links i e-mails (nulstilling af adgangskode, skift af e-mail), fx https://tandmatch.dk.
# Tom: requestens egen adresse. Skal også stå under Site URL / Redirect URLs i Supabase.
SITE_URL=

# HMAC-nøgle til den signerede tm_terms-cookie (mindst 32 tegn). Kun server.
TERMS_COOKIE_SECRET=

# Beskytter /api/cron/cleanup-anonymous (trin 2). Kun server.
CRON_SECRET=


# Notifikationer (platform 14). Uden RESEND_API_KEY og EMAIL_FROM logges e-mails kun (type og id, aldrig indhold). Kun server.
# EMAIL_FROM er afsenderen, fx TandMatch <notifikationer@tandmatch.dk>; domænet skal være verificeret i Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Kun hvis "Enhanced push security" er slået til i Expo-kontoen. Kun server.
EXPO_ACCESS_TOKEN=
# 1 = ingen push til Expo, kun log (udvikling uden telefon). Ignoreres ellers.
PUSH_LOG_ONLY=
# 1 = falske tjenester uden netværkskald (kun til tests; sættes af tests/api/run.sh og tests/e2e/run.sh, ignoreres i produktion).
NOTIFICATIONS_FAKE=

# Web push til klinikkens browser (RFC 8292, VAPID). Lav et nøglepar med: node scripts/generate-vapid-keys.mjs
# Den offentlige nøgle må være i browseren; den private (VAPID_PRIVATE_KEY) må kun stå her og aldrig i git. Uden nøglerne logges web push kun.
# VAPID_SUBJECT er en kontaktadresse, fx mailto:support@tandmatch.dk.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
