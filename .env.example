# Kopiér denne fil til .env.local og udfyld værdierne der. Commit aldrig .env.local.
# Nøgler må kun bruges server-side (server/, proxy.ts, app/api/). Aldrig i klientkode eller logs.

# Supabase (EU-region). NEXT_PUBLIC_* er offentlige, men beskyttes af RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kun server. Må kun bruges til kontosletning, oprydningsjob, seed og admin-scripts.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (kun server)
OPENAI_API_KEY=
OPENAI_MODEL=

# Sidens adresse til links i e-mails (nulstilling af adgangskode, skift af e-mail), fx https://tandmatch.dk.
# Tom: requestens egen adresse. Skal også stå under Site URL / Redirect URLs i Supabase.
SITE_URL=

# HMAC-nøgle til den signerede tm_terms-cookie (mindst 32 tegn). Kun server.
TERMS_COOKIE_SECRET=

# Beskytter /api/cron/cleanup-anonymous (trin 2). Kun server.
CRON_SECRET=

